
{
  "manifest_version": 3,
  "name": "JKLM Bot",
  "version": "1.0",
  "description": "Agente autonomo para BombParty",

  "browser_specific_settings": {
  "gecko": {
    "id": "jkml-bot@tap-proyecto.com",
    "data_collection_permissions": {
      "required": ["none"]
      }
    }
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.jklm.fun/*"
  ],
  "action": {
    "default_popup": "html/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.jklm.fun/*"],
      "all_frames": true,
      "js": ["js/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["diccionarios/diccionarioingles.txt"],
      "matches": ["*://*.jklm.fun/*"]
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
