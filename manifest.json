{
  "manifest_version": 3,
  "name": "JKLM Bot Integrador",
  "version": "1.0",
  "description": "Agente autonomo para BombParty",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.jklm.fun/*"
  ],
  "action": {
    "default_popup": "html/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.jklm.fun/*"],
      "all_frames": true,
      "js": ["js/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["diccionarios/diccionarioingles.txt"],
      "matches": ["*://*.jklm.fun/*"]
    }
  ],
  "icons": {
    "48" : "icons/icon48.png"
  }
}
